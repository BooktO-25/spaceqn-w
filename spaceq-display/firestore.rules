rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return hasUserDoc() && getUserData().get('role', '') == 'SUPER_ADMIN';
    }

    function getUserBusinessId() {
      return hasUserDoc() ? getUserData().get('businessId', '') : '';
    }

    function myRole() {
      return hasUserDoc() ? getUserData().get('role', '') : '';
    }

    // --- Regional Admin: appointed by Super Admin, scoped to one or more
    // geographic regions (see Business.region). Acts like a Super Admin but
    // only within businesses whose region they've been assigned.
    function myAssignedRegions() {
      return hasUserDoc() ? getUserData().get('assignedRegions', []) : [];
    }
    function isRegionalAdmin() {
      return hasUserDoc() && getUserData().get('role', '') == 'REGIONAL_ADMIN';
    }
    function isRegionalAdminForRegion(region) {
      return isRegionalAdmin() && region in myAssignedRegions();
    }
    function isRegionalAdminForBusiness(businessId) {
      return isRegionalAdmin()
        && exists(/databases/$(database)/documents/businesses/$(businessId))
        && isRegionalAdminForRegion(get(/databases/$(database)/documents/businesses/$(businessId)).data.get('region', ''));
    }

    // Role -> action matrix, mirrors src/lib/permissions.ts. Enforced here as
    // the real security boundary; the app's UI gating is just for a good
    // experience, not the source of truth.
    function canManageTeam() {
      return isSuperAdmin() || myRole() == 'BUSINESS_OWNER';
    }
    function canManageDevices() {
      return isSuperAdmin() || myRole() in ['BUSINESS_OWNER', 'MANAGER'];
    }
    function canManageLocations() {
      return canManageDevices();
    }
    function canManageContent() {
      return isSuperAdmin() || myRole() in ['BUSINESS_OWNER', 'MANAGER', 'DESIGNER'];
    }
    function canManagePlaylists() {
      return canManageContent();
    }

    function isOwnTenant(businessId) {
      return getUserBusinessId() == businessId;
    }

    // Users Collection Rules
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin() || isRegionalAdmin() || isOwnTenant(resource.data.get('businessId', '')));
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && (request.resource.data.get('role', '') != 'SUPER_ADMIN' || isSuperAdmin())
        && (request.resource.data.get('role', '') != 'REGIONAL_ADMIN' || isSuperAdmin());
      allow update: if isSignedIn()
        && (
          // Self-updates can't touch role or assignedRegions, and can't
          // reassign an already-set businessId (that would be tenant-
          // hopping) — but CAN set businessId for the first time, going
          // from '' to a real value once, to complete onboarding.
          (request.auth.uid == userId
            && request.resource.data.get('role', '') == resource.data.get('role', '')
            && (
              request.resource.data.get('businessId', '') == resource.data.get('businessId', '')
              || (resource.data.get('businessId', '') == '' && request.resource.data.get('businessId', '') != '')
            ))
          || isSuperAdmin()
          // A Business Owner may change a role of someone already in their
          // own tenant, but never grant SUPER_ADMIN or REGIONAL_ADMIN, and
          // never touch businessId.
          || (canManageTeam()
              && isOwnTenant(resource.data.get('businessId', ''))
              && request.resource.data.get('businessId', '') == resource.data.get('businessId', '')
              && request.resource.data.get('role', '') != 'SUPER_ADMIN'
              && request.resource.data.get('role', '') != 'REGIONAL_ADMIN')
        );
      allow delete: if isSuperAdmin();
    }

    // Team invites - created by a Business Owner for a specific email, and
    // consumed by that person the moment they sign up.
    match /invites/{inviteId} {
      allow read: if isSignedIn() && (
        isSuperAdmin()
        || isOwnTenant(resource.data.get('businessId', ''))
        || resource.data.get('email', '') == request.auth.token.email.lower()
      );
      allow create: if isSignedIn() && (isSuperAdmin() || (canManageTeam() && isOwnTenant(request.resource.data.businessId)));
      allow update: if isSignedIn() && (
        isSuperAdmin()
        || isOwnTenant(resource.data.get('businessId', ''))
        || resource.data.get('email', '') == request.auth.token.email.lower()
      );
      allow delete: if isSuperAdmin() || (isSignedIn() && canManageTeam() && isOwnTenant(resource.data.get('businessId', '')));
    }

    // Businesses Collection Rules
    match /businesses/{businessId} {
      allow read: if isSignedIn() && (isSuperAdmin() || isRegionalAdminForBusiness(businessId) || getUserBusinessId() == businessId || (resource != null && resource.data.id == getUserBusinessId()));
      // A brand-new signed-in user creating their very first business can't
      // already own it (that's the whole point of this call) — so creation
      // only needs to be a genuinely new doc whose ID matches the path.
      // Ownership is established immediately after via the user profile
      // write, in the same onboarding flow.
      allow create: if isSignedIn() && request.resource.data.id == businessId;
      allow update, delete: if isSuperAdmin() || isRegionalAdminForBusiness(businessId) || (isSignedIn() && canManageTeam() && getUserBusinessId() == businessId);
    }

    // Tenant Isolated Collections
    match /locations/{locationId} {
      allow read: if isSignedIn() && (isSuperAdmin() || isRegionalAdminForBusiness(resource.data.businessId) || getUserBusinessId() == resource.data.businessId);
      allow create: if isSignedIn() && (isSuperAdmin() || isRegionalAdminForBusiness(request.resource.data.businessId) || (canManageLocations() && getUserBusinessId() == request.resource.data.businessId));
      allow update, delete: if isSignedIn() && (isSuperAdmin() || isRegionalAdminForBusiness(resource.data.businessId) || (canManageLocations() && getUserBusinessId() == resource.data.businessId));
    }

    match /devices/{deviceId} {
      allow read: if isSignedIn() && (isSuperAdmin() || isRegionalAdminForBusiness(resource.data.businessId) || getUserBusinessId() == resource.data.businessId);
      allow update, delete: if isSignedIn() && (isSuperAdmin() || isRegionalAdminForBusiness(resource.data.businessId) || (canManageDevices() && getUserBusinessId() == resource.data.businessId));

      // --- Kiosk pairing (no login at all — this is intentional) ---
      // A brand-new TV mints its own ID and writes it ONCE as a self-service
      // "unclaimed" placeholder. The doc ID must equal its own pairingCode,
      // it must start unclaimed (businessId ''), and — critically — this
      // only succeeds if no document with that ID already exists, so a
      // stranger can never overwrite or hijack an existing device this way.
      allow create: if request.resource.data.businessId == ''
        && request.resource.data.status == 'PAIRING'
        && request.resource.data.pairingCode == deviceId;

      // Any physical TV needs to read its own doc with zero login, and any
      // Business Owner needs to look a code up by ID before claiming it.
      // This does not allow LISTING devices — only fetching one exact ID —
      // so a stranger can't enumerate anyone's displays this way.
      allow get: if true;

      // Heartbeat + playback telemetry ("proof of play"): no login required,
      // but the kiosk may only ever touch these specific fields on its own
      // device doc — nothing else. Same unauthenticated-write tradeoff as
      // the plain heartbeat already accepted: there's no way to verify the
      // write came from that device specifically, only that it's scoped to
      // exactly these fields.
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'lastSeenAt',
               'status',
               'totalPlaybackSeconds',
               'totalPlaybackCount',
               'lastPlaybackAt',
               'lastPlayedContentId',
               'lastPlayedContentTitle',
               'lastPlaybackDurationSeconds',
               'lastSyncCommandId',
               'lastSyncAt',
               'lastSyncStatus',
               'lastSyncError'
             ])
             && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
                   'lastSyncCommandId', 'lastSyncAt', 'lastSyncStatus', 'lastSyncError'
                 ])
                 || request.resource.data.get('lastSyncCommandId', '') == resource.data.get('syncCommandId', ''))
             && request.resource.data.get('status', resource.data.get('status', 'ONLINE')) in ['ONLINE', 'PAIRING', 'SYNCING'];

      // Claiming: a signed-in Business Owner/Manager turns an unclaimed
      // pairing placeholder into a real device belonging to their tenant.
      // Only works while it's still genuinely unclaimed, and only into
      // their OWN business — never someone else's.
      allow update: if isSignedIn() && canManageDevices()
        && resource.data.status == 'PAIRING' && resource.data.businessId == ''
        && request.resource.data.businessId == getUserBusinessId();
    }

    match /contents/{contentId} {
      allow read: if isSignedIn() && (isSuperAdmin() || isRegionalAdminForBusiness(resource.data.businessId) || getUserBusinessId() == resource.data.businessId);
      allow create: if isSignedIn() && (isSuperAdmin() || isRegionalAdminForBusiness(request.resource.data.businessId) || (canManageContent() && getUserBusinessId() == request.resource.data.businessId));
      allow update, delete: if isSignedIn() && (isSuperAdmin() || isRegionalAdminForBusiness(resource.data.businessId) || (canManageContent() && getUserBusinessId() == resource.data.businessId));

      // Kiosk player fetches each content item it needs by exact ID (never a
      // collection-wide query), so a narrow `get` is enough - this keeps an
      // unauthenticated kiosk session from ever listing/enumerating another
      // business's content library. No login required (kiosks never sign in).
      allow get: if true;
    }

    match /playlists/{playlistId} {
      allow read: if isSignedIn() && (isSuperAdmin() || isRegionalAdminForBusiness(resource.data.businessId) || getUserBusinessId() == resource.data.businessId);
      allow create: if isSignedIn() && (isSuperAdmin() || isRegionalAdminForBusiness(request.resource.data.businessId) || (canManagePlaylists() && getUserBusinessId() == request.resource.data.businessId));
      allow update, delete: if isSignedIn() && (isSuperAdmin() || isRegionalAdminForBusiness(resource.data.businessId) || (canManagePlaylists() && getUserBusinessId() == resource.data.businessId));

      // Kiosk player needs to fetch every playlist assigned to its device by
      // ID. No login required (kiosks never sign in).
      allow get: if true;
    }

    // Scrolling ticker configuration. Dashboard users can list only their own
    // tenant's configs. Unauthenticated kiosk devices can fetch only a known
    // document ID (businessId or businessId_devices), never enumerate configs.
    match /scrollingMessages/{configId} {
      allow get: if true;
      allow list: if isSignedIn()
        && (isSuperAdmin()
          || isRegionalAdminForBusiness(resource.data.businessId)
          || getUserBusinessId() == resource.data.businessId);
      allow create: if isSignedIn()
        && request.resource.data.businessId is string
        && (isSuperAdmin()
          || isRegionalAdminForBusiness(request.resource.data.businessId)
          || (canManageContent() && getUserBusinessId() == request.resource.data.businessId));
      allow update: if isSignedIn()
        && request.resource.data.businessId == resource.data.businessId
        && (isSuperAdmin()
          || isRegionalAdminForBusiness(resource.data.businessId)
          || (canManageContent() && getUserBusinessId() == resource.data.businessId));
      allow delete: if isSignedIn()
        && (isSuperAdmin()
          || isRegionalAdminForBusiness(resource.data.businessId)
          || (canManageContent() && getUserBusinessId() == resource.data.businessId));
    }


    // Editable tenant-wide and selected-device default display slides.
    // Kiosks may fetch only the exact known business/device document IDs.
    match /defaultDisplaySlides/{configId} {
      allow get: if true;
      allow list: if isSignedIn()
        && (isSuperAdmin()
          || isRegionalAdminForBusiness(resource.data.businessId)
          || getUserBusinessId() == resource.data.businessId);
      allow create: if isSignedIn()
        && request.resource.data.businessId is string
        && (isSuperAdmin()
          || isRegionalAdminForBusiness(request.resource.data.businessId)
          || (canManageContent() && getUserBusinessId() == request.resource.data.businessId));
      allow update: if isSignedIn()
        && request.resource.data.businessId == resource.data.businessId
        && (isSuperAdmin()
          || isRegionalAdminForBusiness(resource.data.businessId)
          || (canManageContent() && getUserBusinessId() == resource.data.businessId));
      allow delete: if isSignedIn()
        && (isSuperAdmin()
          || isRegionalAdminForBusiness(resource.data.businessId)
          || (canManageContent() && getUserBusinessId() == resource.data.businessId));
    }

    // Advertisers and campaigns are private to each business tenant.
    match /advertisers/{advertiserId} {
      allow read: if isSignedIn() && (isSuperAdmin() || isRegionalAdminForBusiness(resource.data.businessId) || getUserBusinessId() == resource.data.businessId);
      allow create: if isSignedIn() && request.resource.data.businessId is string
        && (isSuperAdmin() || isRegionalAdminForBusiness(request.resource.data.businessId)
          || (canManageTeam() && getUserBusinessId() == request.resource.data.businessId));
      allow update: if isSignedIn()
        && request.resource.data.businessId == resource.data.businessId
        && (isSuperAdmin() || isRegionalAdminForBusiness(resource.data.businessId)
          || (canManageTeam() && getUserBusinessId() == resource.data.businessId));
      allow delete: if isSignedIn() && (isSuperAdmin() || isRegionalAdminForBusiness(resource.data.businessId)
        || (canManageTeam() && getUserBusinessId() == resource.data.businessId));
    }

    match /campaigns/{campaignId} {
      // Physical kiosks fetch only campaign IDs explicitly attached to their own device document.
      allow get: if true;
      allow read: if isSignedIn() && (isSuperAdmin() || isRegionalAdminForBusiness(resource.data.businessId) || getUserBusinessId() == resource.data.businessId);
      allow create: if isSignedIn() && request.resource.data.businessId is string
        && (isSuperAdmin() || isRegionalAdminForBusiness(request.resource.data.businessId)
          || (canManageContent() && getUserBusinessId() == request.resource.data.businessId));
      allow update: if isSignedIn()
        && request.resource.data.businessId == resource.data.businessId
        && (isSuperAdmin() || isRegionalAdminForBusiness(resource.data.businessId)
          || (canManageContent() && getUserBusinessId() == resource.data.businessId));
      allow delete: if isSignedIn() && (isSuperAdmin() || isRegionalAdminForBusiness(resource.data.businessId)
        || (canManageContent() && getUserBusinessId() == resource.data.businessId));
    }


    // Client-facing report snapshots use the unguessable token as document ID.
    // The access document stores the currently active token for each campaign.
    // This lets a new link immediately invalidate the previous token.
    match /campaignPublicReports/{token} {
      allow get: if exists(/databases/$(database)/documents/campaignReportAccess/$(resource.data.campaignId))
        && get(/databases/$(database)/documents/campaignReportAccess/$(resource.data.campaignId)).data.activeToken == token
        && get(/databases/$(database)/documents/campaignReportAccess/$(resource.data.campaignId)).data.businessId == resource.data.businessId;
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.businessId is string
        && request.resource.data.campaignId is string
        && request.resource.data.keys().hasOnly([
          'businessId', 'campaignId', 'publicReport', 'shareUpdatedAt'
        ])
        && (isSuperAdmin()
          || isRegionalAdminForBusiness(request.resource.data.businessId)
          || (canManageContent() && getUserBusinessId() == request.resource.data.businessId));
      allow update: if isSignedIn()
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.campaignId == resource.data.campaignId
        && request.resource.data.keys().hasOnly([
          'businessId', 'campaignId', 'publicReport', 'shareUpdatedAt'
        ])
        && (isSuperAdmin()
          || isRegionalAdminForBusiness(resource.data.businessId)
          || (canManageContent() && getUserBusinessId() == resource.data.businessId));
      allow delete: if isSignedIn()
        && (isSuperAdmin()
          || isRegionalAdminForBusiness(resource.data.businessId)
          || (canManageContent() && getUserBusinessId() == resource.data.businessId));
    }

    // Private active-token registry. Public clients cannot read or enumerate it.
    match /campaignReportAccess/{campaignId} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.businessId is string
        && request.resource.data.activeToken is string
        && request.resource.data.keys().hasOnly(['businessId', 'activeToken', 'updatedAt'])
        && (isSuperAdmin()
          || isRegionalAdminForBusiness(request.resource.data.businessId)
          || (canManageContent() && getUserBusinessId() == request.resource.data.businessId));
      allow update: if isSignedIn()
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.activeToken is string
        && request.resource.data.keys().hasOnly(['businessId', 'activeToken', 'updatedAt'])
        && (isSuperAdmin()
          || isRegionalAdminForBusiness(resource.data.businessId)
          || (canManageContent() && getUserBusinessId() == resource.data.businessId));
      allow delete: if isSignedIn()
        && (isSuperAdmin()
          || isRegionalAdminForBusiness(resource.data.businessId)
          || (canManageContent() && getUserBusinessId() == resource.data.businessId));
    }

    // Kiosk-generated campaign delivery events. A device may create a
    // completion record only for an ACTIVE campaign assigned to that device.
    // These records are operational proof-of-play, not cryptographic attestation.
    match /campaignPlayLogs/{logId} {
      allow read: if isSignedIn()
        && (isSuperAdmin()
          || isRegionalAdminForBusiness(resource.data.businessId)
          || getUserBusinessId() == resource.data.businessId);
      allow create: if
        request.resource.data.keys().hasOnly([
          'businessId', 'campaignId', 'campaignName', 'deviceId',
          'contentId', 'contentTitle', 'scheduledSlot', 'startedAt',
          'endedAt', 'durationSeconds', 'completed', 'source', 'createdAt'
        ])
        && request.resource.data.source == 'KIOSK_PLAYER'
        && request.resource.data.durationSeconds is number
        && request.resource.data.completed is bool
        && exists(/databases/$(database)/documents/devices/$(request.resource.data.deviceId))
        && exists(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId))
        && get(/databases/$(database)/documents/devices/$(request.resource.data.deviceId)).data.businessId == request.resource.data.businessId
        && get(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId)).data.businessId == request.resource.data.businessId
        && get(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId)).data.status == 'ACTIVE'
        && request.resource.data.deviceId in get(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId)).data.deviceIds
        && get(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId)).data.contentId == request.resource.data.contentId;
      allow update, delete: if false;
    }

    match /activityLogs/{logId} {
      allow read: if isSignedIn() && (isSuperAdmin() || isRegionalAdminForBusiness(resource.data.businessId) || getUserBusinessId() == resource.data.businessId);
      allow create: if isSignedIn() && (isSuperAdmin() || isRegionalAdminForBusiness(request.resource.data.businessId) || getUserBusinessId() == request.resource.data.businessId);
      allow update, delete: if isSignedIn() && (isSuperAdmin() || isRegionalAdminForBusiness(resource.data.businessId) || getUserBusinessId() == resource.data.businessId);
    }
  }
}
